# samverse.space on Hostinger (Apache/LiteSpeed). Mirrors netlify.toml.
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
	RewriteEngine On

	# www -> bare domain (HTTPS itself is forced in hPanel once the SSL certificate is active)
	RewriteCond %{HTTP_HOST} ^www\.samverse\.space$ [NC]
	RewriteRule ^ https://samverse.space%{REQUEST_URI} [L,R=301]

	# Removed case study (owner request, 31 Oct 2026)
	RewriteRule ^work/india-automation-hub/?$ - [G,L]

	# Merged thin posts into stronger pages (6 Nov 2026)
	RewriteRule ^blog/website-accessibility-older-users/?$ /blog/website-accessibility-basics/ [R=301,L]
	RewriteRule ^blog/website-for-real-estate-agents-brokers/?$ /blog/real-estate-website-must-have-features/ [R=301,L]
	RewriteRule ^blog/website-for-property-management-companies/?$ /blog/real-estate-website-must-have-features/ [R=301,L]
	RewriteRule ^blog/restaurant-menu-on-website/?$ /blog/restaurant-website-online-ordering/ [R=301,L]
	RewriteRule ^blog/solar-company-lead-generation/?$ /blog/solar-company-website-guide/ [R=301,L]
	RewriteRule ^blog/website-for-advocates-bar-council-rules/?$ /blog/website-for-lawyers-and-chartered-accountants/ [R=301,L]
	RewriteRule ^blog/website-for-homestays-bnbs/?$ /blog/hotel-website-direct-bookings/ [R=301,L]
	RewriteRule ^blog/domain-hosting-renewal-checklist/?$ /blog/hosting-renewal-price-increase/ [R=301,L]
	RewriteRule ^blog/website-for-farm-stays-agritourism/?$ /blog/hotel-website-direct-bookings/ [R=301,L]
	RewriteRule ^blog/woocommerce-maintenance-checklist/?$ /blog/wordpress-maintenance-checklist/ [R=301,L]
	RewriteRule ^blog/google-business-profile-posts/?$ /blog/google-business-profile-checklist/ [R=301,L]
	RewriteRule ^blog/website-refresh-vs-redesign/?$ /blog/signs-you-need-a-new-website/ [R=301,L]
	RewriteRule ^blog/website-handover-checklist/?$ /blog/website-ownership-checklist/ [R=301,L]
	RewriteRule ^blog/website-disaster-recovery-plan/?$ /blog/wordpress-backup-restore-guide/ [R=301,L]
	RewriteRule ^blog/website-accessibility-audit-checklist/?$ /blog/website-accessibility-basics/ [R=301,L]
	RewriteRule ^blog/website-for-specialist-doctors/?$ /blog/clinic-website-checklist-for-doctors/ [R=301,L]
	RewriteRule ^blog/image-compression-plugins-compared/?$ /blog/image-optimization-wordpress/ [R=301,L]
	RewriteRule ^blog/meet-the-team-page/?$ /blog/write-about-page-that-builds-trust/ [R=301,L]
	RewriteRule ^blog/google-business-profile-photos/?$ /blog/google-business-profile-checklist/ [R=301,L]
	RewriteRule ^blog/website-content-calendar-small-business/?$ /blog/website-content-calendar/ [R=301,L]
	RewriteRule ^blog/hidden-website-costs/?$ /blog/wordpress-website-cost-india/ [R=301,L]
	RewriteRule ^blog/wordpress-user-accounts-audit/?$ /blog/wordpress-user-roles-explained/ [R=301,L]
	RewriteRule ^blog/follow-up-website-leads-fast/?$ /blog/respond-to-website-enquiries-fast/ [R=301,L]
	RewriteRule ^blog/website-quiz-lead-generation/?$ /blog/website-calculators-lead-generation/ [R=301,L]
	RewriteRule ^blog/website-for-computer-training-institutes/?$ /blog/website-for-software-training-institutes/ [R=301,L]
	RewriteRule ^blog/woocommerce-store-running-costs/?$ /blog/ecommerce-website-cost-india/ [R=301,L]
	RewriteRule ^blog/video-testimonials-website/?$ /blog/collect-display-customer-testimonials/ [R=301,L]
	RewriteRule ^blog/white-label-woocommerce-development/?$ /blog/white-label-wordpress-development-agencies/ [R=301,L]
	RewriteRule ^blog/offshore-wordpress-developer-time-zones/?$ /blog/outsource-wordpress-development-india/ [R=301,L]
	RewriteRule ^blog/agency-overflow-wordpress-work/?$ /blog/white-label-wordpress-development-agencies/ [R=301,L]
	RewriteRule ^blog/wordpress-css-changes-not-showing/?$ /blog/wordpress-changes-not-showing/ [R=301,L]
	RewriteRule ^blog/white-label-elementor-development/?$ /blog/white-label-wordpress-development-agencies/ [R=301,L]
	RewriteRule ^blog/wordpress-reseller-for-marketing-agencies/?$ /blog/white-label-wordpress-development-agencies/ [R=301,L]
	RewriteRule ^blog/wordpress-site-not-showing-on-google/?$ /blog/get-website-indexed-google-faster/ [R=301,L]
	RewriteRule ^blog/wordpress-multisite-seo/?$ /blog/wordpress-multisite-when-needed/ [R=301,L]
	RewriteRule ^blog/wordpress-hosting-price-india/?$ /blog/choose-wordpress-hosting-india/ [R=301,L]
	RewriteRule ^blog/wordpress-multisite-slow/?$ /blog/wordpress-multisite-when-needed/ [R=301,L]
	RewriteRule ^blog/wordpress-multisite-development-services/?$ /blog/wordpress-multisite-when-needed/ [R=301,L]
	RewriteRule ^blog/woocommerce-multiple-suppliers/?$ /blog/woocommerce-multi-vendor-marketplace/ [R=301,L]
	RewriteRule ^blog/woocommerce-custom-pricing-plugin-development/?$ /blog/woocommerce-wholesale-dealer-pricing/ [R=301,L]
	RewriteRule ^blog/wordpress-update-and-security-service/?$ /blog/website-maintenance-cost-india/ [R=301,L]
	RewriteRule ^blog/gravity-forms-vs-contact-form-7/?$ /blog/wordpress-form-plugins-compared/ [R=301,L]
	RewriteRule ^blog/squeeze-page-vs-landing-page/?$ /blog/landing-page-vs-website/ [R=301,L]
	RewriteRule ^blog/woocommerce-vendor-onboarding/?$ /blog/woocommerce-multi-vendor-marketplace/ [R=301,L]
	RewriteRule ^blog/remove-fake-pages-wordpress-site/?$ /blog/fix-japanese-keyword-seo-spam-hack/ [R=301,L]
	RewriteRule ^blog/wordpress-developer-hourly-rate-india/?$ /blog/fixed-price-vs-hourly-website-projects/ [R=301,L]
	RewriteRule ^blog/marathi-website-design/?$ /blog/multilingual-wordpress-website-hindi-english/ [R=301,L]

	RewriteRule ^website-cost-calculator/?$ /#contact [R=301,NE,L]

	# The whole repo is deployed, so hide project files from the web
	RewriteRule ^(\.git|node_modules|netlify|tools|docs)(/|$) - [R=404,L]
	RewriteRule ^(package\.json|package-lock\.json|netlify\.toml|README\.md|\.gitignore|\.gitattributes|server\.js|\.htaccess)$ - [R=404,L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
	Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
	# Pages must always be revalidated so new content shows straight away (CSS/JS stay cached)
	<FilesMatch "\.html?$">
		Header set Cache-Control "no-cache"
	</FilesMatch>
</IfModule>
